{%- layout none -%}
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Tarjeta de regalo · {{ shop.name }}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800&display=swap" rel="stylesheet">
    {{ 'ax.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body>
    <main class="ax-container ax-container--narrow" style="padding:40px 16px;display:grid;gap:18px;text-align:center;justify-items:center">
      <img src="{{ 'ax-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="160" height="53">
      <h1 class="ax-title">Tu tarjeta de regalo</h1>
      <p class="ax-pdp__price"><span class="ax-price__now">{{ gift_card.balance | money }}</span></p>
      {%- if gift_card.expired -%}<p class="ax-alert">Esta tarjeta venció el {{ gift_card.expires_on | date: '%d/%m/%Y' }}</p>{%- endif -%}
      <p style="font-size:22px;font-weight:800;letter-spacing:.08em">{{ gift_card.code | format_code }}</p>
      <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>
      <a class="ax-btn" href="{{ shop.url }}">Ir a la tienda</a>
    </main>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
      });
    </script>
  </body>
</html>
