{%- comment -%}
  La solución: cómo el producto resuelve el problema. Metacampos:
  ax.solution_title, ax.solution_text, ax.solution_points ("Título | texto"), ax.solution_image, ax.solution_note
{%- endcomment -%}
{%- liquid
  assign p = section.settings.product | default: product
  assign m = p.metafields.ax
  assign img = m.solution_image.value
-%}
{%- if m.solution_title.value != blank -%}
  <section class="ax-section ax-section--soft" id="solucion" aria-labelledby="ax-solution-{{ section.id }}">
    <div class="ax-container">
      <div class="ax-split{% if section.settings.image_right %} ax-split--reverse{% endif %}">
        {%- if img -%}
          <div class="ax-split__media ax-reveal">
            {{ img | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 900, 1200', sizes: '(min-width: 900px) 560px, 100vw', alt: img.alt | default: '' }}
          </div>
        {%- endif -%}
        <div class="ax-split__copy">
{%- assign head_id = 'ax-solution-' | append: section.id -%}
{% render 'ax-head', eyebrow: section.settings.eyebrow, title: m.solution_title.value, text: m.solution_text.value, id: head_id, left: true %}
          {%- if m.solution_points.value != blank -%}
            <ol class="ax-points">
              {%- for item in m.solution_points.value -%}
                {%- assign parts = item | split: '|' -%}
                <li class="ax-reveal">
                  <span class="ax-points__num">{{ forloop.index }}</span>
                  <div>
                    <h3>{{ parts[0] | strip }}</h3>
                    {%- if parts[1] != blank -%}<p>{{ parts[1] | strip }}</p>{%- endif -%}
                  </div>
                </li>
              {%- endfor -%}
            </ol>
          {%- endif -%}
          {%- if m.solution_note.value != blank -%}
            <p class="ax-note">{% render 'ax-icon', name: 'info' %}<span>{{ m.solution_note.value }}</span></p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
{%- else -%}
  {% render 'ax-hint', text: 'Sección "La solución": llena en el producto el metacampo <code>ax.solution_title</code> (y opcionalmente texto, puntos e imagen).' %}
{%- endif -%}

{% schema %}
{
  "name": "Producto: la solución",
  "settings": [
    { "type": "product", "id": "product", "label": "Producto", "info": "Vacío = el producto de la página." },
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "La solución" },
    { "type": "checkbox", "id": "image_right", "label": "Imagen a la derecha (escritorio)", "default": false }
  ],
  "presets": [{ "name": "Producto: la solución" }]
}
{% endschema %}
