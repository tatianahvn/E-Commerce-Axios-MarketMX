<section class="ax-container ax-container--narrow" style="min-height:100vh;display:grid;align-content:center;gap:20px;justify-items:center;text-align:center;padding:40px 16px">
  <img src="{{ 'ax-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="180" height="59">
  <h1 class="ax-title">{{ section.settings.title }}</h1>
  {%- if shop.password_message != blank -%}<p class="ax-lead">{{ shop.password_message }}</p>{%- endif -%}
  <details style="width:100%;max-width:360px">
    <summary class="ax-link" style="cursor:pointer">{{ 'general.password_page.login_form_heading' | t }}</summary>
    {%- form 'storefront_password', class: 'ax-form' -%}
      {%- if form.errors -%}<p class="ax-alert">{{ 'general.password_page.login_form_error' | t }}</p>{%- endif -%}
      <label class="ax-field">{{ 'general.password_page.login_form_password_label' | t }}<input class="ax-input" type="password" name="password" autocomplete="current-password" required></label>
      <button class="ax-btn ax-btn--dark ax-btn--block" type="submit">{{ 'general.password_page.login_password_button' | t }}</button>
    {%- endform -%}
  </details>
</section>

{% schema %}
{
  "name": "Página con contraseña",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Muy pronto abrimos" }
  ]
}
{% endschema %}
