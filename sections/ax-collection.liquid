{%- paginate collection.products by section.settings.per_page -%}
  <section class="ax-section" style="padding-top:0">
    <div class="ax-container">
      <header class="ax-page-head">
        <h1>{{ collection.title }}</h1>
        {%- if collection.description != blank -%}<div class="ax-rte">{{ collection.description }}</div>{%- endif -%}
      </header>

      <div class="ax-toolbar">
        <span>{{ collection.products_count }} {% if collection.products_count == 1 %}producto{% else %}productos{% endif %}</span>
        {%- if collection.products_count > 1 -%}
          <label>
            <span class="ax-visually-hidden">Ordenar por</span>
            <select class="ax-select" data-ax-sort>
              {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
              {%- endfor -%}
            </select>
          </label>
        {%- endif -%}
      </div>

      {%- if collection.products.size > 0 -%}
        <div class="ax-grid{% if collection.products.size == 1 %} ax-grid--single{% endif %}">
          {%- for item in collection.products -%}
            {%- liquid
              assign eager = false
              if forloop.index <= 2
                assign eager = true
              endif
            -%}
            {% render 'ax-product-card', card_product: item, eager: eager %}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="ax-empty">
          <p>Esta colección todavía no tiene productos.</p>
          <a class="ax-btn ax-btn--small" href="{{ routes.all_products_collection_url }}">Ver todos los productos</a>
        </div>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="ax-pagination" aria-label="Páginas">
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- elsif part.title == paginate.current_page -%}
              <span class="is-current" aria-current="page">{{ part.title }}</span>
            {%- else -%}
              <span>{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Colección",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Productos por página", "min": 4, "max": 48, "step": 4, "default": 24 }
  ]
}
{% endschema %}
