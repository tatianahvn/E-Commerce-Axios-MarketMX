{%- comment -%}
  La solución: beneficios en tarjetas con imagen o GIF. Metacampos:
  axios.solution_title (opcional), axios.solution_text (opcional), axios.benefits ("Título | texto"), axios.benefit_images
{%- endcomment -%}
{%- liquid
  assign p = section.settings.product | default: product
  assign m = p.metafields.axios
  assign images = m.benefit_images.value
  assign icons = 'sparkle,shield,clock,drop,layers,check' | split: ','
  assign count = m.benefits.value.size
  assign title = m.solution_title.value | default: section.settings.title
-%}
{%- if count > 0 -%}
  <section class="ax-section" id="beneficios" aria-labelledby="ax-benefits-{{ section.id }}">
    <div class="ax-container">
{%- assign head_id = 'ax-benefits-' | append: section.id -%}
{% render 'ax-head', eyebrow: section.settings.eyebrow, title: title, text: m.solution_text.value, id: head_id, icon: section.settings.icon %}
      <ul class="ax-benefits{% if count == 2 or count == 4 %} ax-benefits--{{ count }}{% endif %}">
        {%- for item in m.benefits.value -%}
          {%- assign parts = item | split: '|' -%}
          {%- comment -%} Las listas de archivos de Shopify no se pueden leer por posición ([0]); se recorre la lista {%- endcomment -%}
{%- assign img = nil -%}{%- assign item_index = forloop.index0 -%}{%- for candidate in images -%}{%- if forloop.index0 == item_index -%}{%- assign img = candidate -%}{%- break -%}{%- endif -%}{%- endfor -%}
          {%- assign icon_index = forloop.index0 | modulo: icons.size -%}
          <li class="ax-benefit ax-reveal">
            {%- if img -%}
              <div class="ax-benefit__media">
                {{ img | image_url: width: 760 | image_tag: loading: 'lazy', alt: img.alt | default: '' }}
              </div>
            {%- endif -%}
            <div class="ax-benefit__body">
              <span class="ax-benefit__icon">{% render 'ax-icon', name: icons[icon_index] %}</span>
              <div>
                <h3>{{ parts[0] | strip }}</h3>
                {%- if parts[1] != blank -%}<p>{{ parts[1] | strip }}</p>{%- endif -%}
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- else -%}
  {% render 'ax-hint', text: 'Sección "Beneficios": llena en el producto el metacampo <code>axios.benefits</code> (una línea por beneficio: <code>Título | texto</code>).' %}
{%- endif -%}

{% schema %}
{
  "name": "Producto: la solución",
  "settings": [
    { "type": "product", "id": "product", "label": "Producto", "info": "Vacío = el producto de la página." },
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "La solución" },
    {
      "type": "select",
      "id": "icon",
      "label": "Ícono sobre el título",
      "default": "piggy",
      "options": [
        { "value": "", "label": "Ninguno" },
        { "value": "piggy", "label": "Alcancía" },
        { "value": "sparkle", "label": "Brillo" },
        { "value": "shield", "label": "Escudo" }
      ]
    },
    { "type": "text", "id": "title", "label": "Título por defecto", "default": "Resultados que *se notan*", "info": "Cada producto puede cambiarlo con axios.solution_title. Lo que va entre *asteriscos* sale en rojo." }
  ],
  "presets": [{ "name": "Producto: la solución" }]
}
{% endschema %}
