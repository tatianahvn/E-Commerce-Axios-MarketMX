{%- comment -%}
  Bloque de contenido de la página de producto (modelo AIDA). Todo el texto vive en el tema
  (plantilla templates/product.json), sin metacampos.
  Bloques: texto, lista, imagen/GIF/video, frase destacada, precio, botón, contador, nota y estrellas.
  El precio sale del producto en Shopify; los botones llevan a la sección de compra (#comprar).
{%- endcomment -%}
{%- liquid
  assign p = product
  if p == blank
    assign p = collections.all.products.first
  endif
  assign v = p.selected_or_first_available_variant
  assign bg = section.settings.background
  assign head_id = 'ax-copy-' | append: section.id
-%}
<section
  class="ax-section ax-copy{% if bg == 'soft' %} ax-section--soft{% elsif bg == 'dark' %} ax-section--dark{% endif %}{% if section.settings.final %} ax-final{% endif %}"
  {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handleize }}"{% endif %}
  {% if section.settings.title != blank %}aria-labelledby="{{ head_id }}"{% endif %}
>
  <div class="ax-container ax-container--narrow">
    {%- if section.settings.eyebrow != blank or section.settings.title != blank or section.settings.lead != blank -%}
      {% render 'ax-head', eyebrow: section.settings.eyebrow, title: section.settings.title, text: section.settings.lead, id: head_id %}
    {%- endif -%}

    <div class="ax-copy__stack">
      {%- for block in section.blocks -%}
        {%- assign s = block.settings -%}
        {%- case block.type -%}
          {%- when 'text' -%}
            <div class="ax-copy__text ax-copy__text--{{ s.size }} ax-reveal" {{ block.shopify_attributes }}>{{ s.text }}</div>

          {%- when 'lines' -%}
            {%- assign lines = s.lines | newline_to_br | split: '<br />' -%}
            <div class="ax-copy__lines ax-reveal" {{ block.shopify_attributes }}>
              {%- if s.heading != blank -%}<p class="ax-copy__lines-head">{{ s.heading }}</p>{%- endif -%}
              <ul class="ax-lines ax-lines--{{ s.style }}">
                {%- for line in lines -%}
                  {%- assign line = line | strip -%}
                  {%- if line != blank -%}
                    <li>
                      {%- case s.style -%}
                        {%- when 'check' -%}<span class="ax-lines__mark">{% render 'ax-icon', name: 'check' %}</span>
                        {%- when 'x' -%}<span class="ax-lines__mark ax-lines__mark--x">{% render 'ax-icon', name: 'x' %}</span>
                      {%- endcase -%}
                      <span>{% render 'ax-em', text: line %}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>

          {%- when 'media' -%}
            <div class="ax-copy__media ax-copy__media--{{ s.ratio | replace: '/', 'x' }} ax-reveal" {{ block.shopify_attributes }}>
              {% render 'ax-slot', image: s.image, video: s.video, asset: s.asset, poster: s.poster, controls: s.controls, ratio: s.ratio, label: s.label, overlay: s.overlay, alt: s.alt %}
            </div>

          {%- when 'callout' -%}
            <div class="ax-callout ax-reveal" {{ block.shopify_attributes }}>
              <p class="ax-callout__text">{% render 'ax-em', text: s.text %}</p>
              {%- if s.sub != blank -%}<p class="ax-callout__sub">{{ s.sub }}</p>{%- endif -%}
            </div>

          {%- when 'price' -%}
            {%- assign perks = s.perks | newline_to_br | split: '<br />' -%}
            <div class="ax-offer{% unless s.boxed %} ax-offer--plain{% endunless %} ax-reveal" {{ block.shopify_attributes }}>
              {%- if s.label != blank -%}<p class="ax-offer__label">{{ s.label }}</p>{%- endif -%}
              {%- if p != blank -%}
                <p class="ax-offer__price">
                  {%- if s.show_compare and v.compare_at_price > v.price -%}
                    <s>{{ v.compare_at_price | money_without_trailing_zeros }}</s>
                  {%- endif -%}
                  <span>{{ v.price | money_without_trailing_zeros }}{% if s.suffix != blank %} <small>{{ s.suffix }}</small>{% endif %}</span>
                </p>
              {%- endif -%}
              {%- if s.show_badge and v.compare_at_price > v.price -%}
                {%- assign offer_pct = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price | floor -%}
                <span class="ax-badge ax-badge--soft ax-badge--icon ax-offer__badge">{% render 'ax-icon', name: 'tag' %}{{ offer_pct }}% Descuento</span>
              {%- endif -%}
              {%- if s.sub != blank -%}<p class="ax-offer__sub">{{ s.sub }}</p>{%- endif -%}
              {%- if s.perks != blank -%}
                <ul class="ax-offer__perks">
                  {%- for perk in perks -%}
                    {%- assign perk = perk | strip -%}
                    {%- if perk != blank -%}<li>{{ perk }}</li>{%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>

          {%- when 'cta' -%}
            <div class="ax-copy__cta ax-reveal" {{ block.shopify_attributes }}>
              <a class="ax-btn ax-btn--block ax-btn--pulse" href="{{ p.url }}#comprar" data-ax-order>
                <span class="ax-btn__icon">{% render 'ax-icon', name: 'cart' %}</span>
                {% render 'ax-cta-label', text: s.label, sub: s.sub %}
              </a>
            </div>

          {%- when 'countdown' -%}
            <div class="ax-copy__countdown" {{ block.shopify_attributes }}>
              {%- liquid
                assign cd_light = false
                if bg == 'dark'
                  assign cd_light = true
                endif
              -%}
              {%- comment -%} Contador automático por ciclos (mismo producto = mismo ciclo que la caja de compra) {%- endcomment -%}
              {% render 'ax-countdown', key: p.id, label: s.label, light: cd_light %}
            </div>

          {%- when 'note' -%}
            <div class="ax-tip ax-reveal" {{ block.shopify_attributes }}>
              <span class="ax-tip__icon">{% render 'ax-icon', name: s.icon %}</span>
              <div>
                {%- if s.title != blank -%}<p class="ax-tip__title">{{ s.title }}</p>{%- endif -%}
                <p>{{ s.text | escape | newline_to_br }}</p>
              </div>
            </div>

          {%- when 'compare' -%}
            {%- assign heads = s.headers | split: '|' -%}
            {%- assign rows = s.rows | newline_to_br | split: '<br />' -%}
            <div class="ax-copy__compare" {{ block.shopify_attributes }}>
              <div class="ax-compare ax-reveal">
                <table>
                  <thead>
                    <tr>
                      <th scope="col"><span class="ax-visually-hidden">Característica</span></th>
                      {%- for h in heads -%}<th scope="col"{% if forloop.first %} class="is-us"{% endif %}>{{ h | strip }}</th>{%- endfor -%}
                    </tr>
                  </thead>
                  <tbody>
                    {%- for row in rows -%}
                      {%- assign row = row | strip -%}
                      {%- if row == blank -%}{%- continue -%}{%- endif -%}
                      {%- assign cells = row | split: '|' -%}
                      <tr>
                        <th scope="row">{{ cells[0] | strip }}</th>
                        {%- for h in heads -%}
                          {%- assign cell = cells[forloop.index] | strip -%}
                          {%- assign key = cell | downcase | replace: 'í', 'i' -%}
                          <td{% if forloop.first %} class="is-us"{% endif %}>
                            {%- case key -%}
                              {%- when 'si', '✓' -%}<span class="ax-compare__mark ax-compare__mark--yes">{% render 'ax-icon', name: 'check' %}<span class="ax-visually-hidden">Sí</span></span>
                              {%- when 'no', '✗' -%}<span class="ax-compare__mark ax-compare__mark--no">{% render 'ax-icon', name: 'x' %}<span class="ax-visually-hidden">No</span></span>
                              {%- when 'parcial', 'a veces' -%}<span class="ax-compare__mark ax-compare__mark--partial">A veces</span>
                              {%- else -%}<span class="ax-compare__text">{{ cell }}</span>
                            {%- endcase -%}
                          </td>
                        {%- endfor -%}
                      </tr>
                    {%- endfor -%}
                  </tbody>
                </table>
              </div>
              {%- if s.note_title != blank -%}
                <div class="ax-savings ax-reveal">
                  <span class="ax-savings__icon">{% render 'ax-icon', name: 'piggy' %}</span>
                  <div>
                    <p class="ax-savings__title">{% render 'ax-em', text: s.note_title %}</p>
                    {%- if s.note_text != blank -%}<p class="ax-savings__text">{{ s.note_text }}</p>{%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            </div>

          {%- when 'stars' -%}
            <div class="ax-copy__stars ax-reveal" {{ block.shopify_attributes }}>
              <span class="ax-copy__stars-icons" aria-hidden="true">
                {%- for i in (1..5) -%}{% render 'ax-icon', name: 'star' %}{%- endfor -%}
              </span>
              <span class="ax-visually-hidden">5 de 5 estrellas.</span>
              {%- if s.text != blank -%}<p>{{ s.text }}</p>{%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bloque de contenido",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancla (id)", "info": "Opcional. Ej.: problema → la sección se puede enlazar con #problema." },
    { "type": "text", "id": "eyebrow", "label": "Etiqueta" },
    { "type": "text", "id": "title", "label": "Título", "info": "Lo que va entre *asteriscos* sale en rojo." },
    { "type": "textarea", "id": "lead", "label": "Texto debajo del título" },
    {
      "type": "select",
      "id": "background",
      "label": "Fondo",
      "default": "white",
      "options": [
        { "value": "white", "label": "Blanco" },
        { "value": "soft", "label": "Gris claro" },
        { "value": "dark", "label": "Negro" }
      ]
    },
    { "type": "checkbox", "id": "final", "label": "Es el llamado final", "default": false, "info": "Oculta la barra fija de compra mientras esta sección está a la vista." }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Texto",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Texto" },
        {
          "type": "select",
          "id": "size",
          "label": "Tamaño",
          "default": "normal",
          "options": [
            { "value": "normal", "label": "Normal" },
            { "value": "large", "label": "Grande" },
            { "value": "small", "label": "Pequeño" }
          ]
        }
      ]
    },
    {
      "type": "lines",
      "name": "Lista",
      "settings": [
        { "type": "text", "id": "heading", "label": "Encabezado (opcional)" },
        { "type": "textarea", "id": "lines", "label": "Renglones (uno por línea)", "info": "Lo que va entre *asteriscos* sale en rojo." },
        {
          "type": "select",
          "id": "style",
          "label": "Estilo",
          "default": "check",
          "options": [
            { "value": "check", "label": "Palomita roja" },
            { "value": "x", "label": "Tache" },
            { "value": "plain", "label": "Sin ícono (usa los emojis del texto)" },
            { "value": "large", "label": "Lista grande (usa los emojis del texto)" },
            { "value": "cards", "label": "Recuadros individuales (usa los emojis del texto)" },
            { "value": "statement", "label": "Frases grandes" },
            { "value": "chips", "label": "Recuadros en 2 columnas" }
          ]
        }
      ]
    },
    {
      "type": "media",
      "name": "Imagen / GIF / video",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen o GIF" },
        { "type": "video", "id": "video", "label": "Video (tiene prioridad sobre la imagen)" },
        { "type": "text", "id": "asset", "label": "O archivo en assets/", "info": "Nombre exacto del archivo subido con el tema, p. ej. qc-hero.webp, qc-aplicacion.gif o un video .mp4" },
        { "type": "text", "id": "poster", "label": "Imagen mientras carga el video (assets/)", "info": "Solo para videos .mp4 del tema." },
        { "type": "checkbox", "id": "controls", "label": "Mostrar controles del video (reproducir y pausar)", "default": false },
        {
          "type": "select",
          "id": "ratio",
          "label": "Proporción",
          "default": "1/1",
          "options": [
            { "value": "1/1", "label": "Cuadrada 1:1" },
            { "value": "4/5", "label": "Vertical 4:5" },
            { "value": "2/3", "label": "Vertical 2:3" },
            { "value": "9/16", "label": "Vertical 9:16" },
            { "value": "16/9", "label": "Horizontal 16:9" }
          ]
        },
        { "type": "text", "id": "overlay", "label": "Texto encima del archivo (opcional)" },
        { "type": "text", "id": "alt", "label": "Texto alternativo" },
        { "type": "textarea", "id": "label", "label": "Descripción del recuadro gris", "info": "Se ve solo mientras no hay archivo." }
      ]
    },
    {
      "type": "callout",
      "name": "Frase destacada",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Frase", "info": "Lo que va entre *asteriscos* sale en rojo." },
        { "type": "text", "id": "sub", "label": "Texto pequeño debajo" }
      ]
    },
    {
      "type": "price",
      "name": "Precio",
      "settings": [
        { "type": "checkbox", "id": "boxed", "label": "En recuadro", "default": true },
        { "type": "text", "id": "label", "label": "Texto arriba del precio" },
        { "type": "checkbox", "id": "show_compare", "label": "Mostrar precio anterior tachado", "default": false },
        { "type": "checkbox", "id": "show_badge", "label": "Mostrar etiqueta de descuento", "default": false },
        { "type": "text", "id": "suffix", "label": "Después del precio", "default": "MXN" },
        { "type": "text", "id": "sub", "label": "Texto debajo del precio" },
        { "type": "textarea", "id": "perks", "label": "Etiquetas (una por línea)", "default": "🚚 ENVÍO GRATIS A TODO MÉXICO\n💵 PAGAS AL RECIBIR" }
      ]
    },
    {
      "type": "cta",
      "name": "Botón de compra",
      "settings": [
        { "type": "text", "id": "label", "label": "Texto", "default": "QUIERO MI SHINE ARMOR QUICK COAT" },
        { "type": "text", "id": "sub", "label": "Segunda línea", "default": "Envío GRATIS · Pagas al recibir" }
      ]
    },
    {
      "type": "countdown",
      "name": "Contador de la oferta",
      "settings": [
        { "type": "text", "id": "label", "label": "Texto", "default": "La oferta termina en" }
      ]
    },
    {
      "type": "note",
      "name": "Nota / tip",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "default": "info",
          "options": [
            { "value": "info", "label": "Información" },
            { "value": "sun", "label": "Sol" },
            { "value": "sparkle", "label": "Brillo" },
            { "value": "shield", "label": "Escudo" }
          ]
        },
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "textarea", "id": "text", "label": "Texto" }
      ]
    },
    {
      "type": "compare",
      "name": "Comparativa",
      "settings": [
        { "type": "text", "id": "headers", "label": "Columnas", "default": "Shine Armor | Cera tradicional | Autolavado", "info": "Separadas por |. La primera se resalta." },
        { "type": "textarea", "id": "rows", "label": "Filas (una por línea)", "info": "Característica | si | no | parcial  (si, no, parcial o un texto corto)" },
        { "type": "text", "id": "note_title", "label": "Recuadro de ahorro: título", "info": "Lo que va entre *asteriscos* sale en rojo. Vacío = sin recuadro." },
        { "type": "textarea", "id": "note_text", "label": "Recuadro de ahorro: texto" }
      ]
    },
    {
      "type": "stars",
      "name": "Estrellas",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "Resultados visibles desde la primera aplicación" }
      ]
    }
  ],
  "presets": [{ "name": "Bloque de contenido" }]
}
{% endschema %}
