{%- comment -%}
  Barra de avisos: cinta que corre hacia la izquierda sin cortes.
  Los avisos se repiten para llenar pantallas anchas; la segunda mitad es una copia
  (oculta para lectores de pantalla) que permite que la vuelta sea continua.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  {%- capture ax_announce_items -%}
    {%- for i in (1..3) -%}
      {%- for block in section.blocks -%}
        <span class="ax-announce__item"{% if forloop.parentloop.first %} {{ block.shopify_attributes }}{% endif %}>
          {% render 'ax-icon', name: block.settings.icon %}
          <span>{% render 'ax-tokens', text: block.settings.text %}</span>
        </span>
      {%- endfor -%}
    {%- endfor -%}
  {%- endcapture -%}
  <div class="ax-announce" role="region" aria-label="Avisos" style="--ax-announce-speed: {{ section.settings.speed }}s">
    <div class="ax-announce__track">
      <div class="ax-announce__group">{{ ax_announce_items }}</div>
      <div class="ax-announce__group" aria-hidden="true">{{ ax_announce_items }}</div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de avisos",
  "max_blocks": 5,
  "settings": [
    { "type": "range", "id": "speed", "label": "Duración de una vuelta", "min": 15, "max": 90, "step": 5, "unit": "s", "default": 40, "info": "Menos segundos = corre más rápido." }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Aviso",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "Pagas al recibir: pago contra entrega", "info": "Puedes usar [envio] y [dias]." },
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "default": "cash",
          "options": [
            { "value": "cash", "label": "Efectivo" },
            { "value": "truck", "label": "Envío" },
            { "value": "shield", "label": "Escudo" },
            { "value": "fire", "label": "Fuego" },
            { "value": "gift", "label": "Regalo" },
            { "value": "return", "label": "Devolución" }
          ]
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "item", "settings": { "text": "Pagas al recibir: pago contra entrega", "icon": "cash" } },
      { "type": "item", "settings": { "text": "Envío GRATIS a todo México con número de rastreo", "icon": "truck" } },
      { "type": "item", "settings": { "text": "Garantía de satisfacción de [dias] días", "icon": "shield" } }
    ]
  }
}
{% endschema %}
