{%- comment -%}
  Lista de productos del inicio. Con un solo producto la tarjeta queda centrada.
{%- endcomment -%}
{%- assign source = collections[section.settings.collection] | default: collections.all -%}
{%- assign count = source.products.size -%}
{%- if count > section.settings.limit -%}{%- assign count = section.settings.limit -%}{%- endif -%}
<section class="ax-section" id="productos" aria-labelledby="ax-grid-{{ section.id }}">
  <div class="ax-container">
    {%- assign head_id = 'ax-grid-' | append: section.id -%}
    {% render 'ax-head', eyebrow: section.settings.eyebrow, title: section.settings.title, text: section.settings.text, id: head_id %}
    {%- if count > 0 -%}
      <div class="ax-grid{% if count == 1 %} ax-grid--single{% elsif count == 4 or count > 6 %} ax-grid--4{% endif %}">
        {%- for item in source.products limit: section.settings.limit -%}
          {%- liquid
            assign eager = false
            if forloop.index <= 2
              assign eager = true
            endif
          -%}
          {% render 'ax-product-card', card_product: item, eager: eager, cta: section.settings.card_cta %}
        {%- endfor -%}
      </div>
      {%- if source.products.size > section.settings.limit -%}
        <p style="text-align:center;margin-top:24px"><a class="ax-btn ax-btn--ghost ax-btn--small" href="{{ source.url }}">Ver todos los productos</a></p>
      {%- endif -%}
    {%- else -%}
      <p class="ax-empty">Pronto agregaremos productos.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Lista de productos",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Lo más vendido" },
    { "type": "text", "id": "title", "label": "Título", "default": "Nuestros *productos*" },
    { "type": "textarea", "id": "text", "label": "Texto" },
    { "type": "collection", "id": "collection", "label": "Colección", "info": "Vacío = todos los productos." },
    { "type": "range", "id": "limit", "label": "Máximo de productos", "min": 1, "max": 24, "step": 1, "default": 12 },
    { "type": "text", "id": "card_cta", "label": "Botón de las tarjetas", "default": "Ver producto" }
  ],
  "presets": [{ "name": "Lista de productos" }]
}
{% endschema %}
