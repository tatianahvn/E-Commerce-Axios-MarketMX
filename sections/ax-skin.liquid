{%- comment -%}
  Paleta propia para UNA plantilla de producto (no cambia el resto de la tienda).
  Va primero en la plantilla: carga assets/ax-calido.css, que redefine los colores y la letra (Nunito) solo dentro del contenido de la página (encabezado y pie se quedan igual).
{%- endcomment -%}
{%- if section.settings.skin == 'calido' -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
  {{ 'ax-calido.css' | asset_url | stylesheet_tag }}
  <script>
    // Botón de Releasit con el color de esta landing. Releasit escribe su color en línea con !important,
    // así que se reemplaza por script cada vez que pone (o vuelve a dibujar) su botón.
    (function () {
      var paint = function (btn) {
        // Si el estilo es el mismo que dejamos la última vez, no se toca (evita repintar sin fin)
        if (btn.__axStyle && btn.getAttribute('style') === btn.__axStyle) return;
        btn.style.setProperty('background', '#b95a1a', 'important');
        btn.style.setProperty('box-shadow', '0 8px 20px rgba(185, 90, 26, 0.35)', 'important');
        btn.__axStyle = btn.getAttribute('style');
      };
      var scan = function () {
        document.querySelectorAll('#ax-main ._rsi-buy-now-button').forEach(paint);
      };
      new MutationObserver(scan).observe(document.documentElement, {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: ['style']
      });
      document.addEventListener('DOMContentLoaded', scan);
    })();

    // Reseñas compactas: los textos largos se cortan a 5 líneas y llevan "Leer más"
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('#resenas .ax-review__text').forEach(function (text) {
        if (text.scrollHeight - text.clientHeight < 4) return;
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'ax-review__more';
        btn.textContent = 'Leer más';
        btn.setAttribute('aria-expanded', 'false');
        btn.addEventListener('click', function () {
          var open = text.closest('.ax-review').classList.toggle('is-open');
          btn.textContent = open ? 'Leer menos' : 'Leer más';
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
        text.after(btn);
      });
    });
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Paleta de la página",
  "settings": [
    {
      "type": "select",
      "id": "skin",
      "label": "Colores",
      "default": "calido",
      "options": [
        { "value": "", "label": "Los de la tienda" },
        { "value": "calido", "label": "Miel y canela (crema, miel, canela y café)" }
      ]
    }
  ],
  "presets": [{ "name": "Paleta de la página" }]
}
{% endschema %}
