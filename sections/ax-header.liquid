{%- liquid
  assign menu = linklists[section.settings.menu]
-%}
<header class="ax-header" data-ax-header style="--ax-logo-w: {{ section.settings.logo_width_mobile }}px; --ax-logo-w-desk: {{ section.settings.logo_width }}px;">
  <div class="ax-container ax-header__inner">
    <button class="ax-icon-btn ax-header__menu-btn" type="button" data-ax-menu-open aria-controls="ax-drawer" aria-expanded="false" aria-label="Abrir menú">
      {% render 'ax-icon', name: 'menu' %}
    </button>

    <a class="ax-brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}, inicio">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 480 | image_tag: alt: shop.name, loading: 'eager', fetchpriority: 'high' }}
      {%- else -%}
        <img src="{{ 'ax-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="480" height="158" fetchpriority="high">
      {%- endif -%}
    </a>

    <nav class="ax-nav" aria-label="Principal">
      {%- if menu.links.size > 0 -%}
        {%- for link in menu.links -%}
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="{{ routes.root_url }}">Inicio</a>
        <a href="{{ routes.all_products_collection_url }}">Productos</a>
        <a href="{{ routes.root_url }}#preguntas">Preguntas</a>
      {%- endif -%}
    </nav>

    <div class="ax-header__right">
      <a class="ax-icon-btn" href="{{ routes.search_url }}" aria-label="Buscar">{% render 'ax-icon', name: 'search' %}</a>
    </div>
  </div>
</header>

<div class="ax-drawer" id="ax-drawer" data-ax-drawer aria-hidden="true">
  <div class="ax-drawer__backdrop" data-ax-menu-close></div>
  <div class="ax-drawer__panel" role="dialog" aria-modal="true" aria-label="Menú">
    <div class="ax-drawer__head">
      <img src="{{ 'ax-logo.png' | asset_url }}" alt="" width="480" height="158" loading="lazy">
      <button class="ax-icon-btn" type="button" data-ax-menu-close aria-label="Cerrar menú">{% render 'ax-icon', name: 'x' %}</button>
    </div>
    <nav class="ax-drawer__nav" aria-label="Menú móvil">
      {%- if menu.links.size > 0 -%}
        {%- for link in menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}{% render 'ax-icon', name: 'chevron-right' %}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="{{ routes.root_url }}">Inicio{% render 'ax-icon', name: 'chevron-right' %}</a>
        <a href="{{ routes.all_products_collection_url }}">Productos{% render 'ax-icon', name: 'chevron-right' %}</a>
        <a href="{{ routes.root_url }}#preguntas">Preguntas frecuentes{% render 'ax-icon', name: 'chevron-right' %}</a>
      {%- endif -%}
      <a href="{{ routes.search_url }}">Buscar{% render 'ax-icon', name: 'search' %}</a>
    </nav>
    <div class="ax-drawer__foot">
      <span>{% render 'ax-icon', name: 'cash' %} Pagas al recibir, sin tarjeta</span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Encabezado",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menú", "default": "main-menu" },
    { "type": "range", "id": "logo_width_mobile", "label": "Ancho del logo en celular", "min": 90, "max": 200, "step": 2, "unit": "px", "default": 132 },
    { "type": "range", "id": "logo_width", "label": "Ancho del logo en escritorio", "min": 100, "max": 260, "step": 2, "unit": "px", "default": 156 }
  ]
}
{% endschema %}
